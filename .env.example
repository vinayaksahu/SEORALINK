# SEORALINK Centralized Platform Configuration

# Database URLs (From Neon.tech console -> Dashboard -> Connection Details)
# DATABASE_URL: Use the "Pooled connection" string (with pgbouncer / pooled endpoint) for Serverless Next.js
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/neondb?sslmode=require"

# DIRECT_URL: Use the direct / unpooled connection string (required for Prisma migrations/push)
DIRECT_URL="postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/neondb?sslmode=require"

# Schema used in postgres (default: public or seoralink)
DB_SCHEMA="public"

# Auth Session Secret (Generate a 32+ character random string)
JWT_SECRET="your-super-secret-jwt-key-minimum-32-characters"

# Cron secret for background tasks / queue automation
CRON_SECRET="your-secure-cron-secret-key"

# App Info & Public URL (In Vercel production, set to your domain e.g. https://your-project.vercel.app)
NEXT_PUBLIC_APP_NAME="SEORALINK"
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# System Deposit Defaults (Admin USDT BEP20 Wallet)
DEFAULT_DEPOSIT_USDT_ADDRESS="0x71C569E9903b41D8B4eAE6b22312dE9d89Ae0001"
DEFAULT_DEPOSIT_NETWORK="USDT_BEP20"
