generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ROOT_ADMIN
  SUPER_ADMIN
  ADMIN
  USER
}

enum AccountStatus {
  INACTIVE
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum QueueStatus {
  WAITING
  COMPLETED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  DEPOSIT
  ACTIVATION
  DIRECT_COMMISSION
  UPLINE_OVERRIDE
  RANK_REWARD
  PROTOCOL_RESERVE_DEDUCTION
  WITHDRAWAL
  WITHDRAWAL_REFUND
  ADMIN_ADJUSTMENT
}

model User {
  id                 String              @id @default(cuid())
  customId           String              @unique // e.g. "SL839102"
  fullName           String
  email              String              @unique
  phone              String?
  passwordHash       String
  transactionPin     String?
  role               UserRole            @default(USER)
  status             AccountStatus       @default(INACTIVE)

  referralCode       String              @unique // matches customId
  sponsorId          String?
  sponsor            User?               @relation("ReferralTree", fields: [sponsorId], references: [id])
  directs            User[]              @relation("ReferralTree")

  adminId            String?             // Root branch admin ID this user belongs to
  assignedAdmin      User?               @relation("AdminTeamMembers", fields: [adminId], references: [id])
  teamMembers        User[]              @relation("AdminTeamMembers")
  teamPrefix         String?             // Branch code or team prefix


  usdtAddress        String?
  usdtNetwork        String?             @default("USDT_BEP20")
  depositMode        String              @default("GLOBAL") // "GLOBAL", "AUTOMATIC", "MANUAL"

  currentTier        Int                 @default(0) // 0=Junior, 1=Zen ... 12=Ultima
  directCount        Int                 @default(0) // Active direct referrals

  fundBalance        Decimal             @default(0.0) @db.Decimal(20, 8)
  incomeBalance      Decimal             @default(0.0) @db.Decimal(20, 8) // Commission Wallet
  totalEarned        Decimal             @default(0.0) @db.Decimal(20, 8)
  totalWithdrawn     Decimal             @default(0.0) @db.Decimal(20, 8)

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  queueEntries            QueueEntry[]
  ledgers                 LedgerEntry[]
  deposits                DepositRequest[]
  depositAddresses        DepositAddress[]
  adminDepositPermissions AdminDepositPermission[] @relation("AdminDepositPermissions")
  withdrawals             WithdrawalRequest[]
  tickets                 SupportTicket[]

  @@index([customId])
  @@index([email])
  @@index([sponsorId])
  @@index([adminId])
  @@index([currentTier])
  @@index([status])
}

model QueueEntry {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id])
  adminId          String?      // Isolated parallel admin branch ID
  tier             Int          // 0 to 12
  queueIndex       Int          // Sequential index in tier queue
  childrenPlaced   Int          @default(0) // 0, 1, or 2 (Tripod matching)
  status           QueueStatus  @default(WAITING)

  matchedAt        DateTime?
  upgradedAt       DateTime?
  createdAt        DateTime     @default(now())

  @@index([adminId, tier, queueIndex])
  @@index([adminId, tier, status])
  @@index([userId, tier])
  @@index([tier, status])
  @@index([tier, queueIndex])
}

model LedgerEntry {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  type             TransactionType
  wallet           String          // "FUND" or "INCOME"
  amount           Decimal         @db.Decimal(20, 8)
  balanceBefore    Decimal         @db.Decimal(20, 8)
  balanceAfter     Decimal         @db.Decimal(20, 8)
  referenceKey     String          @unique
  description      String
  sourceUserId     String?
  tierNumber       Int?
  createdAt        DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([referenceKey])
}

model DepositRequest {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  amount           Decimal       @default(0.0) @db.Decimal(20, 8)
  amountInUsdt     Decimal       @default(0.0) @db.Decimal(20, 8)
  txHash           String        @unique
  network          String        @default("USDT_BEP20")
  tokenContract    String?
  fromAddress      String?
  toAddress        String?
  blockNumber      BigInt?
  confirmations    Int           @default(0)
  processingMode   String        @default("MANUAL") // "AUTOMATIC" | "MANUAL"
  status           String        @default("PENDING") // PENDING, CONFIRMING, CONFIRMED, CREDITED, PENDING_REVIEW, APPROVED, REJECTED, CREDIT_PENDING_PAUSED, FAILED
  screenshotUrl    String?
  adminNote        String?
  rejectionReason  String?
  approvalNotes    String?
  reviewedBy       String?
  approvedById     String?
  detectedAt       DateTime?
  confirmedAt      DateTime?
  creditedAt       DateTime?
  reviewedAt       DateTime?
  approvedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt

  @@index([userId])
  @@index([status])
  @@index([toAddress, tokenContract])
  @@index([processingMode, status])
  @@index([blockNumber])
}

model DepositAddress {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  network         String        @default("BSC")
  asset           String        @default("USDT")
  address         String        @unique
  derivationIndex Int           @unique
  status          String        @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([address])
}

model BlockchainCheckpoint {
  id                 String    @id // "bsc_usdt_mainnet"
  lastProcessedBlock BigInt
  latestKnownBlock   BigInt
  status             String    @default("IDLE") // IDLE | RUNNING
  lastSuccessfulScan DateTime?
  lastError          String?
  updatedAt          DateTime  @updatedAt
}

model AdminDepositPermission {
  id          String   @id @default(cuid())
  adminId     String
  admin       User     @relation("AdminDepositPermissions", fields: [adminId], references: [id], onDelete: Cascade)
  permission  String
  grantedById String?
  createdAt   DateTime @default(now())

  @@unique([adminId, permission])
  @@index([adminId])
}

model WithdrawalRequest {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  amount           Decimal       @db.Decimal(20, 8)
  feePercent       Decimal       @db.Decimal(5, 2)
  feeAmount        Decimal       @db.Decimal(20, 8)
  netAmount        Decimal       @db.Decimal(20, 8)
  toAddress        String
  network          String        @default("USDT_BEP20")
  txHash           String?
  adminNote        String?
  status           RequestStatus @default(PENDING)
  processedAt      DateTime?
  processedById    String?
  createdAt        DateTime      @default(now())

  @@index([userId])
  @@index([status])
}

model SystemConfig {
  id               String        @id @default(cuid())
  key              String        @unique
  value            String
  description      String?
  updatedAt        DateTime      @updatedAt
}

model SupportTicket {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  subject          String
  category         String
  message          String
  status           String        @default("OPEN") // OPEN, RESOLVED, CLOSED
  adminReply       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId])
}

model EmailOtp {
  id        String   @id @default(cuid())
  email     String
  code      String
  purpose   String   // "REGISTRATION", "FORGOT_PASSWORD", "WITHDRAWAL", "PROFILE_UPDATE"
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, purpose])
  @@index([createdAt])
}

model UserSessionLog {
  id            String   @id @default(cuid())
  userId        String?
  customId      String
  fullName      String?
  role          String   // USER, ADMIN, SUPER_ADMIN, SUPER_ROOT_ADMIN
  adminId       String?  // Associated branch admin ID
  ipAddress     String
  country       String?
  city          String?
  userAgent     String?
  deviceType    String?  // MOBILE, DESKTOP, TABLET, UNKNOWN
  browser       String?
  os            String?
  status        String   // SUCCESS, FAILED
  failureReason String?
  portal        String?  // member, admin, super_root
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([adminId, createdAt])
  @@index([customId])
  @@index([ipAddress])
  @@index([createdAt])
}

model ActivityLog {
  id             String   @id @default(cuid())
  userId         String?
  customId       String
  fullName       String?
  role           String
  adminId        String?  // Associated branch admin ID
  action         String   // e.g. DEPOSIT_APPROVED, WITHDRAWAL_REQUEST, PROFILE_UPDATE, SIMULATOR_RUN
  category       String   // AUTH, FINANCE, SECURITY, SYSTEM, MEMBER
  details        String?  @db.Text
  targetUserId   String?
  targetCustomId String?
  ipAddress      String
  country        String?
  city           String?
  userAgent      String?
  deviceType     String?
  browser        String?
  os             String?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([adminId, createdAt])
  @@index([category])
  @@index([action])
  @@index([targetCustomId])
  @@index([createdAt])
}


